{
  "name": "daily-learning",
  "version": "1.1.0",
  "description": "Windows 桌面端 AI 学习笔记助手：一次生成三种讲解风格，可归档到 Notion 或自动存成本机 Markdown",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklzues/daily-learning.git"
  },
  "homepage": "https://github.com/jklzues/daily-learning#readme",
  "bugs": {
    "url": "https://github.com/jklzues/daily-learning/issues"
  },
  "keywords": [
    "electron",
    "windows",
    "notion",
    "markdown",
    "ai",
    "notes",
    "llm"
  ],
  "author": "jklzues",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "marked": "^4.3.0"
  },
  "build": {
    "appId": "com.dailylearning.app",
    "productName": "Daily Learning",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles/**/*",
      "scripts/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/logo.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
